#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
python3 - <<'PY'
from pathlib import Path
import ast
import os
from receiver_session import ReceiverSession, SampleFormatError, collect, parse_sample

assert parse_sample("alpha,-67.5") == ("alpha", -67.5)
for bad in ("broken", ",-30", "alpha,loud"):
    try:
        parse_sample(bad)
    except SampleFormatError:
        pass
    else:
        raise AssertionError(f"{bad!r} must raise SampleFormatError")

session = collect(["alpha,-67.5", "broken", "bravo,-51"])
assert session.samples == [("alpha", -67.5), ("bravo", -51.0)]
assert session.errors == ["broken"] and session.attempted == 3
assert session.is_open is False
probe = ReceiverSession()
try:
    with probe:
        raise LookupError("probe")
except LookupError:
    pass
else:
    raise AssertionError("__exit__ must not suppress exceptions")
assert probe.is_open is False

tree = ast.parse(Path("receiver_session.py").read_text())
assert any(isinstance(n, ast.With) for n in ast.walk(tree)), "collect must use with"
handlers = [n for n in ast.walk(tree) if isinstance(n, ast.Try)]
assert any(n.handlers and n.orelse and n.finalbody for n in handlers), "use try/except/else/finally"

raw = Path(".flagpath").read_text().strip() if Path(".flagpath").exists() else os.environ.get("ACADEMY_FLAG_PATH", "~/flag.txt")
path = Path(raw).expanduser()
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text('')
print("Correct! Flag written to", path)
PY
