#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
python3 - <<'PY'
from pathlib import Path
import analyze
import radio_tools

expected = ["-35 dBm: excellent", "-67 dBm: usable", "-92 dBm: weak"]
assert analyze.build_report() == expected, "report output is not correct"
assert radio_tools.dbm_to_quality(-67) == "usable", "package does not export dbm_to_quality"

flag_path = Path(".flagpath").read_text().strip() if Path(".flagpath").exists() else None
if not flag_path:
    import os
    flag_path = os.environ.get("ACADEMY_FLAG_PATH", "~/flag.txt")
path = Path(flag_path).expanduser()
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text('')
print("Correct! Flag written to", path)
PY
