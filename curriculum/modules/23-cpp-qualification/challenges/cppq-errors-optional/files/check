#!/usr/bin/env python3
import os
import subprocess
from pathlib import Path

source = Path("errors.cpp").read_text()
required = ("[[nodiscard]]", "std::optional", "std::nullopt", "throw std::invalid_argument")
if any(item not in source for item in required):
    raise SystemExit("Not yet: use nodiscard, optional/nullopt, and invalid_argument as specified.")
if "marker && false" in source:
    raise SystemExit("Not yet: validate the optional marker and checksum.")

build = subprocess.run(
    ["g++", "-std=c++17", "-Wall", "-Wextra", "-Werror", "-fsanitize=address,undefined",
     "errors.cpp", "-o", "errors"],
    text=True, capture_output=True,
)
if build.returncode:
    raise SystemExit("Not yet: compile failed:\n" + build.stderr)
run = subprocess.run(
    ["./errors"], text=True, capture_output=True,
    env={**os.environ, "ASAN_OPTIONS": "detect_leaks=1"},
)
if run.returncode or run.stdout.strip() != "SAFE":
    raise SystemExit("Not yet: explicitly handle all outcomes and decode SAFE.\n" + run.stderr)

marker = Path(".flagpath")
target = Path(marker.read_text().strip()) if marker.exists() else Path(os.environ.get("ACADEMY_FLAG_PATH", "/home/flag.txt"))
target.parent.mkdir(parents=True, exist_ok=True)
target.write_text('')
print('CHECK_OK')
