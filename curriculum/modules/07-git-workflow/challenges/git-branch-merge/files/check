#!/usr/bin/env python3
import subprocess
from pathlib import Path

from pathlib import Path
import os
def award():
    print('CHECK_OK')

repo=Path("lab")
def sh(cmd,cwd):
    return subprocess.check_output(cmd,cwd=cwd,shell=True,text=True,stderr=subprocess.DEVNULL).strip()
try:
    assert sh('git branch --show-current',repo)=='main'
    text=(repo/'radio.conf').read_text()
    assert all(x in text for x in ['gain=10','filter=wide','sample_rate=2048000'])
    assert len(sh('git rev-list --parents -n 1 HEAD',repo).split())==3
except Exception as e:
    print("Not ready:", e); raise SystemExit(1)
award()
