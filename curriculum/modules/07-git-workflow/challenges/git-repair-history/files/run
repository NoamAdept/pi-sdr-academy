#!/bin/sh
set -eu
if [ -d lab/.git ]; then
  echo 'The local lab already exists; leaving your progress unchanged.'
  exit 0
fi
rm -rf lab; mkdir lab; cd lab; git init -q; git config user.name Academy; git config user.email academy@local
printf 'mode=FM\ngain=8\n' > radio.conf; git add .; git commit -qm 'working receiver mode'
printf 'mode=AM\ngain=8\n' > radio.conf; git commit -qam 'accidentally change mode'
echo 'Use git revert on the bad commit; keep both old commits in history.'
