#!/usr/bin/env python3
import subprocess
from pathlib import Path

from pathlib import Path
import os
def award():
    print('CHECK_OK')

repo=Path("lab")
def sh(cmd,cwd):
    return subprocess.check_output(cmd,cwd=cwd,shell=True,text=True,stderr=subprocess.DEVNULL).strip()
try:
    ans=Path('answer.txt').read_text().split('=',1)[-1].strip()
    assert 'center_hz=91500000' in sh(f'git show {ans}:radio.conf',repo)
    assert 'center_hz=100000000' in sh(f'git show {ans}^:radio.conf',repo)
except Exception as e:
    print("Not ready:", e); raise SystemExit(1)
award()
