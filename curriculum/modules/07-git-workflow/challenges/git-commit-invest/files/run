#!/bin/sh
set -eu
if [ -d lab/.git ]; then
  echo 'The local lab already exists; leaving your progress unchanged.'
  exit 0
fi
rm -rf lab; mkdir lab; cd lab; git init -q; git config user.name Academy; git config user.email academy@local
printf 'GAIN=2\n' > receiver.conf; git add .; git commit -qm 'add receiver configuration'
printf 'GAIN=2\nBAD_GAIN=9\n' > receiver.conf; git commit -qam 'tune receiver gain'
printf 'GAIN=3\nBAD_GAIN=9\n' > receiver.conf; git commit -qam 'adjust normal gain'
cd ..; printf 'culprit=\n' > answer.txt
