#!/usr/bin/env python3
import socket, subprocess, sys, threading
server = socket.socket()
server.bind(("127.0.0.1", 0)); server.listen(1)
port = server.getsockname()[1]
def serve():
    conn, _ = server.accept()
    with conn:
        request = b""
        while not request.endswith(b"\n"):
            request += conn.recv(100)
        conn.sendall(b"channel=7 ")
        conn.sendall(b"power=-38\n")
    server.close()
t = threading.Thread(target=serve, daemon=True); t.start()
raise_code = subprocess.call([sys.executable, "client.py", "127.0.0.1", str(port), "7"])
t.join(3)
if t.is_alive():
    server.close()
    print("The client did not connect to the local practice server.", file=sys.stderr)
    raise SystemExit(1)
raise SystemExit(raise_code)
