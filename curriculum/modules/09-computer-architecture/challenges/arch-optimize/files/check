#!/usr/bin/env python3
import subprocess
from pathlib import Path

from pathlib import Path
import os
def award():
    print('CHECK_OK')

def parse(text):
    return dict(line.split('=',1) for line in text.splitlines() if '=' in line)
try:
    subprocess.run(['./run'],check=True)
    vals=parse(Path('answer.txt').read_text())
    assert subprocess.check_output(['./sum_o0'],text=True)==subprocess.check_output(['./sum_o2'],text=True)=='sum=499500\n'
    assert int(vals.get('size_o0','0'))==Path('sum_o0').stat().st_size
    assert int(vals.get('size_o2','0'))==Path('sum_o2').stat().st_size
except Exception as e:
    print("Not ready:", e); raise SystemExit(1)
award()
