#!/usr/bin/env python3
import os
import subprocess
from pathlib import Path

source = Path("receiver.cpp").read_text()
required = ("extern \"C\"", "std::atomic", "std::mutex", "memory_order_release", "memory_order_acquire")
if any(item not in source for item in required):
    raise SystemExit("Not yet: retain the C callback and use mutex plus release/acquire atomic publication.")
if "volatile bool packet_ready" in source:
    raise SystemExit("Not yet: volatile does not make the shared flag thread-safe.")

build = subprocess.run(
    ["g++", "-std=c++17", "-Wall", "-Wextra", "-Werror", "-fsanitize=address,undefined",
     "-pthread", "receiver.cpp", "-o", "receiver"],
    text=True, capture_output=True,
)
if build.returncode:
    raise SystemExit("Not yet: compile failed:\n" + build.stderr)
run = subprocess.run(
    ["./receiver"], text=True, capture_output=True,
    env={**os.environ, "ASAN_OPTIONS": "detect_leaks=1"},
)
if run.returncode or run.stdout.strip() != "LOCK:5:4660":
    raise SystemExit("Not yet: expected LOCK:5:4660 after safe packet transfer.\n" + run.stderr)

marker = Path(".flagpath")
target = Path(marker.read_text().strip()) if marker.exists() else Path(os.environ.get("ACADEMY_FLAG_PATH", "/home/flag.txt"))
target.parent.mkdir(parents=True, exist_ok=True)
target.write_text('')
print('CHECK_OK')
