#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
python3 - <<'PY'
from pathlib import Path
import os
from signal_meter import SignalMeter, CalibratedSignalMeter

plain = SignalMeter("bench")
assert plain.name == "bench"
try:
    plain.average_dbm()
except ValueError:
    pass
else:
    raise AssertionError("an empty meter must raise ValueError")
plain.add_sample(-80)
plain.add_sample(-70)
assert plain.average_dbm() == -75.0

meter = CalibratedSignalMeter("roof", 2.5)
assert isinstance(meter, SignalMeter)
for value in (-72, -68, -70):
    meter.add_sample(value)
assert meter.average_dbm() == -67.5
try:
    meter.offset_db = 20.1
except ValueError:
    pass
else:
    raise AssertionError("invalid offsets must raise ValueError")

raw = Path(".flagpath").read_text().strip() if Path(".flagpath").exists() else os.environ.get("ACADEMY_FLAG_PATH", "~/flag.txt")
path = Path(raw).expanduser()
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text('')
print("Correct! Flag written to", path)
PY
