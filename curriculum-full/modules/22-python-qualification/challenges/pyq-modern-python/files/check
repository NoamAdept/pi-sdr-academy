#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
python3 - <<'PY'
from pathlib import Path
from dataclasses import FrozenInstanceError, is_dataclass
import ast
import inspect
import os
from packet_router import Packet, route

assert is_dataclass(Packet), "Packet must be a dataclass"
packet = Packet("ping")
try:
    packet.kind = "data"
except FrozenInstanceError:
    pass
else:
    raise AssertionError("Packet must be frozen")

before = route.calls
assert route(Packet("ping")) == "PING"
assert route(Packet("data", b"\x01\xaf")) == "DATA:01af"
assert route(Packet("data")) == "EMPTY"
assert route(Packet("noise")) == "DROP:noise"
assert route.calls == before + 4
assert route.__name__ == "route" and route.__doc__, "use functools.wraps"
assert inspect.signature(route).return_annotation is str

tree = ast.parse(Path("packet_router.py").read_text())
assert any(isinstance(n, ast.Match) for n in ast.walk(tree)), "route must use match/case"
assert any(isinstance(n, ast.FunctionDef) and n.returns for n in ast.walk(tree)), "add return type hints"

raw = Path(".flagpath").read_text().strip() if Path(".flagpath").exists() else os.environ.get("ACADEMY_FLAG_PATH", "~/flag.txt")
path = Path(raw).expanduser()
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text('')
print("Correct! Flag written to", path)
PY
