#!/usr/bin/env python3
import subprocess
from pathlib import Path

from pathlib import Path
import os
def award():
    print('CHECK_OK')

def parse(text):
    return dict(line.split('=',1) for line in text.splitlines() if '=' in line)
try:
    subprocess.run(['./run'],check=True)
    vals=parse(Path('answer.txt').read_text())
    out=subprocess.check_output(['./probe'],text=True); actual=parse(out)
    assert vals.get('first_byte')==actual.get('first_byte') and vals.get('order')==actual.get('order')
except Exception as e:
    print("Not ready:", e); raise SystemExit(1)
award()
