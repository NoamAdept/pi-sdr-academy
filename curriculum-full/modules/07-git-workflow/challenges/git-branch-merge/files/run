#!/bin/sh
set -eu
if [ -d lab/.git ]; then
  echo 'The local lab already exists; leaving your progress unchanged.'
  exit 0
fi
rm -rf lab; mkdir lab; cd lab; git init -q; git config user.name Academy; git config user.email academy@local
git branch -M main; printf 'gain=10\n' > radio.conf; git add .; git commit -qm base
git checkout -qb feature/filter; printf 'filter=wide\n' >> radio.conf; git commit -qam 'add filter setting'
git checkout -q main; printf 'sample_rate=2048000\n' >> radio.conf; git commit -qam 'set sample rate'
echo 'Merge feature/filter into main and preserve all three lines.'
